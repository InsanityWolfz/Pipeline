{
  "name": "pipeline",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run sound && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "measure": "vitest run --config vitest.measure.config.ts",
    "check": "npm run typecheck && npm run lint && vitest run --passWithNoTests --changed origin/main",
    "check:full": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:prod": "npm run build && playwright test -c playwright.prod.config.ts",
    "sound": "node scripts/build-sound.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
